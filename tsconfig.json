{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // Edge Functions are Deno code with their own runtime globals — not part of
  // the React Native app's TS project.
  "exclude": ["node_modules", "supabase/functions"]
}
