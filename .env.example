# Copy this file to .env and fill in your own values. Never commit .env.

# Supabase project settings (Project Settings > API in the Supabase dashboard)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional — increases Pokemon TCG API rate limits. Get one free at https://dev.pokemontcg.io
EXPO_PUBLIC_POKEMON_TCG_API_KEY=

# Optional — enables automatic card detection when scanning (reads name + number).
# Set ONE of these. If neither is set, scanning falls back to manual search.
#  - Google Cloud Vision (most accurate): enable the Vision API, create an API key.
#    https://console.cloud.google.com/apis/library/vision.googleapis.com
EXPO_PUBLIC_GOOGLE_VISION_API_KEY=
#  - OCR.space (free instant key, no billing): https://ocr.space/ocrapi
EXPO_PUBLIC_OCRSPACE_API_KEY=
